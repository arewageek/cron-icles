{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cron-icles",
	"compatibility_date": "2025-08-03",
	"main": "./src/index.ts",
	"secrets": {
		"required": [
			"ADMIN_SECRET"
		]
	},
	"d1_databases": [
		{
			"binding": "cron_icles",
			"database_name": "cron-icles",
			"database_id": "fea269fc-8b0a-41b6-a80e-1dd9c21f4a59"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "DISPATCH_QUEUE",
				"queue": "cron-icles-dispatch"
			}
		],
		"consumers": [
			{
				"queue": "cron-icles-dispatch",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 3
			}
		]
	},
	"triggers": {
		"crons": [
			"* * * * *"
		]
	}
}